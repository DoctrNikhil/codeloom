{
  "name": "codeloom-vscode",
  "displayName": "CodeLoom",
  "description": "Turn AI-generated diffs into atomic, traceable, MBD-aligned git commits",
  "version": "0.2.0",
  "publisher": "DoctrNikhil",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "commits",
    "diff",
    "atomic",
    "MBD",
    "traceability",
    "ai-generated-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DoctrNikhil/codeloom"
  },
  "bugs": {
    "url": "https://github.com/DoctrNikhil/codeloom/issues"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeloom.analyzeWorkingTree",
        "title": "CodeLoom: Analyze Working Tree",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "codeloom.analyzeStaged",
        "title": "CodeLoom: Analyze Staged Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "codeloom.analyzeFromDiffFile",
        "title": "CodeLoom: Analyze a Diff File"
      },
      {
        "command": "codeloom.executePlan",
        "title": "CodeLoom: Execute Plan",
        "icon": "$(play)"
      },
      {
        "command": "codeloom.dryRun",
        "title": "CodeLoom: Dry Run",
        "icon": "$(beaker)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeloom",
          "title": "CodeLoom",
          "icon": "$(git-merge)"
        }
      ]
    },
    "views": {
      "codeloom": [
        {
          "id": "codeloom.planView",
          "name": "Commit Plan",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeloom.analyzeWorkingTree",
          "when": "view == codeloom.planView",
          "group": "navigation@1"
        },
        {
          "command": "codeloom.analyzeStaged",
          "when": "view == codeloom.planView",
          "group": "navigation@2"
        },
        {
          "command": "codeloom.dryRun",
          "when": "view == codeloom.planView",
          "group": "navigation@3"
        },
        {
          "command": "codeloom.executePlan",
          "when": "view == codeloom.planView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "CodeLoom",
      "properties": {
        "codeloom.manifestPath": {
          "type": "string",
          "default": "design/manifest.yaml",
          "description": "Workspace-relative path to the MBD manifest YAML."
        },
        "codeloom.defaultBranch": {
          "type": "string",
          "default": "",
          "description": "Feature branch name for plan execution (empty = current branch)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.3.3"
  }
}
