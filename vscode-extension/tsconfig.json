{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "codeloom/*": ["../codeloom/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out", "src/test/**", "src/__mocks__/**"]
}
