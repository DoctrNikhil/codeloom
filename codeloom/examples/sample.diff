+import { hashPassword, verifyPassword } from '../src/auth/hash';
+import { generateToken, verifyToken } from '../src/auth/jwt';
+import { loginUser } from '../src/endpoints/login';
+
+describe('password hashing', () => {
+  it('hashes a password', async () => {
+    const hash = await hashPassword('my-secure-password');
+    expect(hash).not.toBe('my-secure-password');
+    expect(hash.startsWith('$2b$')).toBe(true);
+  });
+
+  it('verifies correct password', async () => {
+    const hash = await hashPassword('my-secure-password');
+    const valid = await verifyPassword('my-secure-password', hash);
+    expect(valid).toBe(true);
+  });
+});
+
+describe('JWT generation', () => {
+  it('generates and verifies a token', () => {
+    const fakeUser = { id: '123', email: 'a@b.com', username: 'ab', passwordHash: '', createdAt: new Date(), updatedAt: new Date() };
+    const token = generateToken(fakeUser);
+    const payload = verifyToken(token);
+    expect(payload.userId).toBe('123');
+    expect(payload.email).toBe('a@b.com');
+  });
+});
