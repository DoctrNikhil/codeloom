new file mode 100644
--- /dev/null
+++ b/src/auth/rate-limiter.ts
@@ -0,0 +1,20 @@
+const attemptMap = new Map<string, { count: number; resetAt: number }>();
+
+const MAX_ATTEMPTS = 5;
+const WINDOW_MS = 15 * 60 * 1000; // 15 minutes
+
+export function checkRateLimit(email: string): void {
+  const now = Date.now();
+  const record = attemptMap.get(email);
+
+  if (record && now < record.resetAt) {
+    if (record.count >= MAX_ATTEMPTS) {
+      throw new Error(`Too many login attempts. Try again after ${new Date(record.resetAt).toISOString()}`);
+    }
+    record.count++;
+  } else {
+    attemptMap.set(email, { count: 1, resetAt: now + WINDOW_MS });
+  }
+}
+
+export function clearRateLimit(email: string): void {
+  attemptMap.delete(email);
+}
diff --git a/src/endpoints/login.ts b/src/endpoints/login.ts
new file mode 100644
--- /dev/null
+++ b/src/endpoints/login.ts
@@ -0,0 +1,24 @@
+import { LoginCredentials, User } from '../types/user';
+import { verifyPassword } from '../auth/hash';
+import { generateToken } from '../auth/jwt';
+import { checkRateLimit, clearRateLimit } from '../auth/rate-limiter';
+
+export async function loginUser(
+  credentials: LoginCredentials,
+  findUser: (email: string) => Promise<User | null>
+): Promise<{ token: string; user: User }> {
+  checkRateLimit(credentials.email);
+
+  const user = await findUser(credentials.email);
+  if (!user) {
+    throw new Error('Invalid email or password');
+  }
+
+  const valid = await verifyPassword(credentials.password, user.passwordHash);
+  if (!valid) {
+    throw new Error('Invalid email or password');
+  }
+
+  clearRateLimit(credentials.email);
+  const token = generateToken(user);
+  return { token, user };
+}
